# انسخ هذا الملف إلى .env واملأ القيم الحقيقية (لا ترفع .env نفسه إلى git)

PORT=4000
JWT_SECRET=غيّر-هذا-إلى-نص-عشوائي-طويل-وسرّي
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-كلمة-السر-هذه

# رابط الاتصال بقاعدة بيانات MongoDB Atlas — يجب أن يكون نفس الرابط
# المستخدَم في مشروع lwf-finance-system حتى تبقى كل البيانات (المستخدمون،
# الحكام، والبيانات المالية) موحّدة بين المشروعين.
MONGODB_URI=

# Cloudinary — تخزين الملفات المرفوعة (وثائق الحكام)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
